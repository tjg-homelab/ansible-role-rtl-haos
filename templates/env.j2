# RTL-HAOS Configuration
# Managed by Ansible — do not edit manually.

# --- MQTT SETTINGS ---
MQTT_HOST={{ rtl_haos_mqtt_host }}
MQTT_USER={{ rtl_haos_mqtt_user }}
MQTT_PASS={{ rtl_haos_mqtt_pass }}
{% if rtl_haos_mqtt_port is defined %}
MQTT_PORT={{ rtl_haos_mqtt_port }}
{% endif %}

# --- RTL-SDR CONFIGURATION ---
# JSON array of radio configs: name, id (serial), freq, rate
RTL_CONFIG='{{ rtl_haos_rtl_config }}'

# --- DEVICE FILTERING ---
{% if rtl_haos_device_whitelist is defined %}
DEVICE_WHITELIST='{{ rtl_haos_device_whitelist }}'
{% endif %}
{% if rtl_haos_device_blacklist is defined %}
DEVICE_BLACKLIST='{{ rtl_haos_device_blacklist }}'
{% endif %}

# --- PUBLISHING SETTINGS ---
{% if rtl_haos_expire_after is defined %}
RTL_EXPIRE_AFTER={{ rtl_haos_expire_after }}
{% endif %}
{% if rtl_haos_throttle_interval is defined %}
RTL_THROTTLE_INTERVAL={{ rtl_haos_throttle_interval }}
{% endif %}
{% if rtl_haos_debug_raw_json is defined %}
DEBUG_RAW_JSON={{ rtl_haos_debug_raw_json | lower }}
{% endif %}
{% if rtl_haos_force_new_ids is defined %}
FORCE_NEW_IDS={{ rtl_haos_force_new_ids | lower }}
{% endif %}

# --- UI / LOGGING ---
{% if rtl_haos_show_timestamps is defined %}
RTL_SHOW_TIMESTAMPS={{ rtl_haos_show_timestamps | lower }}
{% endif %}
{% if rtl_haos_verbose_transmissions is defined %}
VERBOSE_TRANSMISSIONS={{ rtl_haos_verbose_transmissions | lower }}
{% endif %}

# --- BATTERY LOW ---
{% if rtl_haos_battery_ok_clear_after is defined %}
BATTERY_OK_CLEAR_AFTER={{ rtl_haos_battery_ok_clear_after }}
{% endif %}
